<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>PuttingLab</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>0.2.1</string>
    <key>CFBundleVersion</key>
    <string>15</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>gyroscope</string>
        <string>accelerometer</string>
        <string>magnetometer</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>NSCameraUsageDescription</key>
    <string>PuttingLab uses the rear camera (via ARKit world tracking) to measure which direction your phone is pointing while you putt. Camera images are processed on-device and are never recorded, saved, or uploaded.</string>
    <key>NSMotionUsageDescription</key>
    <string>PuttingLab reads your iPhone's gyroscope, accelerometer, and magnetometer to measure your putting stroke tempo, face angle, and impact. All motion data stays on your device.</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- Expose the Documents folder (and its StrokeReplays sub-folder) to the
         iOS Files app so testers can bulk-export captured stroke JSONs to
         Drive/iCloud/email without tapping each one individually. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
</dict>
</plist>
